{
  "name": "@acrosticle/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Cloudflare Worker + Durable Objects for real-time puzzle rooms.",
  "type": "module",
  "scripts": {
    "dev": "npm run ensure-assets-dir && npm run db:migrate:local && wrangler dev --var APP_ORIGIN:http://localhost:5173",
    "serve": "npm run ensure-assets-dir && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply acrosticle --local",
    "db:migrate:remote": "wrangler d1 migrations apply acrosticle --remote",
    "cf-typegen": "wrangler types --strict-vars=false",
    "typecheck": "tsc --noEmit",
    "ensure-assets-dir": "node -e \"require('node:fs').mkdirSync('../web/dist', { recursive: true })\""
  },
  "dependencies": {
    "@acrosticle/core": "0.0.0",
    "@acrosticle/parser": "0.0.0",
    "@acrosticle/protocol": "0.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "wrangler": "^4.158.0"
  }
}
