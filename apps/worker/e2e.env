# Settings for the Playwright e2e worker (loaded instead of .dev.vars).
# Sign-in stays unconfigured so e2e never depends on real Google accounts.
APP_ORIGIN=http://localhost:5174
SITE_KIND=acrostic
ACROSTIC_ORIGIN=http://localhost:5174
CROSSWORD_ORIGIN=http://localhost:5176
SIGN_IN_ORIGIN=http://localhost:5174
COOKIE_DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CREATOR_ALLOWLIST=
ANTHROPIC_API_KEY=
# Test servers only: guests may start sample rooms (production requires the allowlist).
GUEST_SAMPLES=on
