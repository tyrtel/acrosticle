{
  "name": "acrosticle",
  "private": true,
  "version": "0.0.0",
  "description": "Real-time collaborative acrostic puzzle solving.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,worker -c cyan,magenta \"npm run dev -w @acrosticle/web\" \"npm run dev -w @acrosticle/worker\"",
    "setup:signin": "node scripts/setup-signin.ts",
    "doctor:signin": "node scripts/doctor-signin.ts",
    "setup:claude": "node scripts/setup-claude.ts",
    "doctor:claude": "node scripts/doctor-claude.ts",
    "eval:parse": "esbuild scripts/eval-parse.ts --bundle --platform=node --format=esm --external:@playwright/test --external:@anthropic-ai/sdk --log-level=warning --outfile=node_modules/.cache/acrosticle/eval-parse.mjs && node node_modules/.cache/acrosticle/eval-parse.mjs",
    "deploy": "node scripts/deploy.ts",
    "smoke": "node scripts/smoke.ts",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude \"**/tests/integration/**\"",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-istanbul": "^5.1.0",
    "concurrently": "^9.2.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true
  }
}
